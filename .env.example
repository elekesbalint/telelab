# Copy to .env and fill in:  cp .env.example .env && nano .env

# Web address (DNS A record must point to this server)
DOMAIN=telelab.balintelekes.hu

# Server IP shown to drivers in the connection instructions
PUBLIC_IP=193.201.186.58

# Database password: any long random string, e.g. output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Shared login for the web UI until Discord login is ready.
# Create the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes around the hash (it contains $ signs).
BASIC_AUTH_USER=telelab
BASIC_AUTH_HASH='paste-hash-here'

# Delete raw recordings older than this many days
RECORD_DAYS=7
