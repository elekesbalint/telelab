# Copy to .env and fill in, or let scripts/install.sh create it.

# Web address (DNS A record must point to this server)
DOMAIN=telelab.balintelekes.hu

# Server IP shown to drivers in the connection instructions
PUBLIC_IP=193.201.186.58

# Database password: any long random string, e.g. output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Discord application (discord.com/developers/applications -> OAuth2)
# Redirect URL to register there: https://<DOMAIN>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Team Discord server ID: its members are approved automatically
DISCORD_GUILD_ID=

# Delete raw recordings older than this many days
RECORD_DAYS=7
